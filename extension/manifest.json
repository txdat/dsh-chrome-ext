{
  "manifest_version": 3,
  "name": "DSH Web",
  "version": "0.1.0",
  "description": "Starts `npx @deepseek-ai/dsh web --no-open` through a native host and opens the tokenized URL in this Chrome.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Web",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
